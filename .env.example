# ── Meta / WhatsApp Business Cloud API ──────────────────────────────
# All four come from the Meta Developer app once the WABA is provisioned.
# The runtime starts WITHOUT them (mock transport) so the bot is fully
# buildable and demoable while Business Verification is pending.

# App Secret (App Settings → Basic). Signs every inbound webhook.
WA_APP_SECRET=

# A string you invent. Paste the same value into the webhook config in the
# Meta console; Meta echoes it back during the GET verification handshake.
WA_VERIFY_TOKEN=change-me-to-a-long-random-string

# System User access token (permanent) or a temporary dev token.
WA_ACCESS_TOKEN=

# Phone Number ID — NOT the phone number itself. WhatsApp → API Setup.
WA_PHONE_NUMBER_ID=

# Graph API version. Bump deliberately; Meta deprecates on a ~2 year cycle.
WA_GRAPH_VERSION=v21.0

# ── Runtime ─────────────────────────────────────────────────────────
PORT=3100
SANCHAR_DB_PATH=./data/sanchar.db

# Conversation session TTL in ms. Defaults to 24h to line up with the
# WhatsApp customer-service window — a user returning after the window
# closed starts a fresh session rather than resuming a half-filled form.
SANCHAR_SESSION_TTL_MS=86400000
